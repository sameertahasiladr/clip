# Production public URL (required for YouTube & Meta OAuth callbacks)
# Example: https://your-app.onrender.com or https://clipgenie.yourdomain.com
APP_URL=https://your-live-domain.com

# Server port (cloud hosts like Render/Railway/Cloud Run set this automatically)
PORT=3000

# Optional Redis URL for BullMQ background job queue (falls back to in-memory queue if omitted)
REDIS_URL=

# Optional AI API keys for transcript moment selection & Whisper fallback
GEMINI_API_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=

# Optional Cloudinary storage for persistent clip URLs (required for direct Instagram Reels publishing)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YouTube OAuth 2.0 (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
# Add Authorized Redirect URI: <APP_URL>/api/social/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Facebook & Instagram Reels OAuth (Meta Developers)
# Add Valid OAuth Redirect URI: <APP_URL>/api/social/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=

# Recommended for cloud datacenter hosts (Render/Railway/Cloud Run) to avoid YouTube bot checks:
# Base64-encoded Netscape cookies.txt exported from a logged-in YouTube session
YTDLP_COOKIES_B64=
# Or optional residential proxy URL (e.g. http://user:pass@host:port)
YTDLP_PROXY=
