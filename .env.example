# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: Public base URL of the ClipGenie server (used for OAuth callback URIs).
# AI Studio injects this automatically at runtime; locally use http://localhost:3000.
APP_URL=http://localhost:3000

# Optional AI & media keys
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Social Publishing OAuth (YouTube Data API v3 + Meta Graph API for Facebook Pages & Instagram Reels)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
